<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Servanda</AssemblyName>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Servanda.Infrastructure\Servanda.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="launcher-error.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\linux\install-desktop.sh"
             Link="install-desktop.sh"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\linux\uninstall-desktop.sh"
             Link="uninstall-desktop.sh"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\linux\servanda.desktop.in"
             Link="servanda.desktop.in"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

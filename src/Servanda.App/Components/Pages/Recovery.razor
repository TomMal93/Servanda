@page "/recovery"
@layout RecoveryLayout
@using Servanda.Infrastructure.Data
@inject DatabaseRecoveryCoordinator RecoveryCoordinator

<PageTitle>Odzyskiwanie — Servanda</PageTitle>

<section class="system-message system-message--warning" aria-labelledby="recovery-heading">
    <p class="eyebrow">Tryb odzyskiwania</p>
    <h1 id="recovery-heading">Servanda nie może otworzyć magazynu danych</h1>
    <p>
        Zwykłe obszary i operacje zapisu są tymczasowo niedostępne. Dane nie zostały zastąpione
        pustą kolekcją.
    </p>

    <dl class="recovery-status">
        <div>
            <dt>Kategoria problemu</dt>
            <dd>@FailureDescription</dd>
        </div>
        <div>
            <dt>Kopia ochronna</dt>
            <dd>@BackupDescription</dd>
        </div>
    </dl>

    <p id="recovery-retry-failure"
       class="recovery-error"
       role="alert"
       hidden="@(Retry != "failed")">
        Ponowna próba nie powiodła się. Baza i istniejąca kopia pozostały zachowane.
    </p>

    <p id="recovery-restore-failure"
       class="recovery-error"
       role="alert"
       hidden="@(Restore != "failed")">
        Nie udało się bezpiecznie odtworzyć kopii. Baza i zweryfikowana kopia nie zostały
        celowo usunięte; jeżeli powstał artefakt diagnostyczny, również został zachowany.
    </p>

    <form id="recovery-retry" method="post" action="@RecoveryEndpoint.RetryPath">
        <AntiforgeryToken />
        <button type="button">Ponów przygotowanie magazynu</button>
    </form>

    @if (Snapshot.RestorableBackup is { } backup)
    {
        <section class="recovery-restore" aria-labelledby="recovery-restore-heading">
            <h2 id="recovery-restore-heading">Odtwórz zweryfikowaną kopię</h2>
            <p>
                Dostępna jest zgodna kopia z @backup.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'").
                Odtworzenie zastąpi bieżącą bazę, ale najpierw zachowa ją jako osobny artefakt
                diagnostyczny.
            </p>
            <form id="recovery-restore" method="post" action="@RecoveryEndpoint.RestorePath">
                <AntiforgeryToken />
                <div class="recovery-confirmation">
                    <input id="confirm-recovery-restore"
                           name="confirmRestore"
                           type="checkbox"
                           value="true" />
                    <label for="confirm-recovery-restore">
                        Rozumiem, że bieżąca baza zostanie zastąpiona zweryfikowaną kopią.
                    </label>
                </div>
                <button type="button" disabled>Odtwórz kopię i uruchom ponownie</button>
            </form>
        </section>
    }
    else
    {
        <p class="system-message__detail">
            Nie znaleziono zgodnej, zweryfikowanej kopii możliwej do odtworzenia.
        </p>
    }

    <p class="system-message__detail">
        Jeżeli problem się powtarza, zamknij Servandę i zachowaj katalog danych do diagnostyki.
        Szczegóły techniczne nie są wyświetlane w przeglądarce.
    </p>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Retry { get; set; }

    [SupplyParameterFromQuery]
    public string? Restore { get; set; }

    private RecoverySnapshot Snapshot => RecoveryCoordinator.Snapshot;

    private string FailureDescription => Snapshot.Failure switch
    {
        DatabaseInitializationFailure.ProtectionBackup => "Nie udało się utworzyć lub zweryfikować kopii ochronnej.",
        DatabaseInitializationFailure.Migration => "Nie udało się bezpiecznie zaktualizować schematu bazy.",
        _ => "Nie udało się otworzyć lub sprawdzić lokalnej bazy.",
    };

    private string BackupDescription => Snapshot.BackupState switch
    {
        ProtectionBackupState.Verified => "Utworzona i zweryfikowana przed próbą aktualizacji.",
        _ => "Nie została utworzona; operacja nie przeszła do chronionej aktualizacji.",
    };
}

@page "/dane"
@using Servanda.Application.DataTransfer
@inject ICollectionExportService ExportService
@inject ICollectionImportService ImportService
@inject CollectionChangeNotifier CollectionChanges

<PageTitle>Dane kolekcji — Servanda</PageTitle>

<div class="module-page">
    <header class="module-page__header">
        <p class="module-page__eyebrow">Kolekcja</p>
        <h1>Eksport i import danych</h1>
        <p>
            Eksport zapisuje przenośny dokument JSON w prywatnym katalogu danych. Import zastępuje całą kolekcję
            po zweryfikowaniu dokumentu i utworzeniu kopii ochronnej.
        </p>
    </header>

    <section class="module-editor" aria-labelledby="export-heading">
        <h2 id="export-heading">Eksport</h2>
        <button class="button button--primary" type="button" @onclick="ExportAsync" disabled="@_busy">
            @(_busy ? "Pracuję…" : "Eksportuj kolekcję")
        </button>

        @if (_export is not null)
        {
            <p role="status" aria-live="polite">
                Zapisano dokument @_export.ExportId z @_export.ExportedAt.ToLocalTime().ToString("g").
            </p>
            <p class="field__hint">Plik: @_export.FilePath</p>
            <ul class="prompt-versions__list">
                <li>Obszary: @_export.Areas</li>
                <li>Kategorie: @_export.Categories</li>
                <li>Tagi: @_export.Tags</li>
                <li>Narzędzia: @_export.Tools</li>
                <li>Prompty: @_export.Prompts</li>
                <li>Historia użycia: @_export.PromptUsage</li>
            </ul>
        }
    </section>

    <section class="module-editor" aria-labelledby="import-heading">
        <h2 id="import-heading">Import zastępujący kolekcję</h2>
        <p class="field__hint">
            Import usuwa rekordy nieobecne w dokumencie i unieważnia formularze otwarte przed zastąpieniem kolekcji.
        </p>

        <div class="field">
            <label for="import-file">Dokument eksportu (JSON)</label>
            <InputFile id="import-file" OnChange="PrepareAsync" accept=".json,application/json" disabled="@_busy" />
        </div>

        @if (_preview is not null)
        {
            <h3>Podgląd skutków</h3>
            @if (_preview.Status == ImportPreviewStatus.Rejected)
            {
                <p class="module-editor__conflict" role="alert">
                    Dokument został odrzucony. Kolekcja i kopia ochronna pozostały bez zmian.
                </p>
                <ul class="prompt-versions__list">
                    @foreach (var problem in _preview.Problems)
                    {
                        <li class="field__error">@problem</li>
                    }
                </ul>
            }
            else
            {
                <p role="status" aria-live="polite">Wersja schematu dokumentu: @_preview.SchemaVersion.</p>
                <table class="import-preview">
                    <caption>Liczba elementów dodawanych, zastępowanych i usuwanych w każdej sekcji</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sekcja</th>
                            <th scope="col">Dodane</th>
                            <th scope="col">Zastąpione</th>
                            <th scope="col">Usunięte</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _preview.Sections)
                        {
                            <tr @key="row.Section">
                                <th scope="row">@row.Section</th>
                                <td>@row.Added</td>
                                <td>@row.Replaced</td>
                                <td>@row.Removed</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <label class="module-editor__confirm">
                    <input type="checkbox" @bind="_importConfirmed" />
                    Rozumiem, że import zastąpi całą kolekcję, usunie nieobecne dane i unieważni otwarte edytory
                </label>

                <div class="module-editor__actions">
                    <button class="button button--primary" type="button" @onclick="ApplyAsync"
                            disabled="@(_busy || !_importConfirmed)">
                        Zastąp całą kolekcję
                    </button>
                    <button type="button" @onclick="DiscardAsync" disabled="@_busy">Anuluj import</button>
                </div>
            }
        }

        @if (_result is not null)
        {
            <p role="status" aria-live="polite">
                @(_result.Status switch
                {
                    ImportApplyStatus.Applied =>
                        $"Kolekcja została zastąpiona. Kopia ochronna: {_result.BackupId}.",
                    ImportApplyStatus.Expired =>
                        "Podgląd wygasł. Wczytaj dokument ponownie.",
                    _ => "Import nie został wykonany.",
                })
            </p>
            @foreach (var problem in _result.Problems ?? [])
            {
                <p class="field__error">@problem</p>
            }
        }
    </section>
</div>

@code {
    private const long MaximumDocumentSize = 64L * 1024 * 1024;

    private ExportSummary? _export;
    private ImportPreview? _preview;
    private ImportResult? _result;
    private bool _busy;
    private bool _importConfirmed;

    private async Task ExportAsync()
    {
        _busy = true;
        _export = await ExportService.ExportAsync();
        _busy = false;
    }

    private async Task PrepareAsync(InputFileChangeEventArgs args)
    {
        _busy = true;
        _result = null;
        if (_preview?.Token is { } previousToken)
        {
            await ImportService.DiscardAsync(previousToken);
        }

        _importConfirmed = false;
        await using var stream = args.File.OpenReadStream(MaximumDocumentSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        buffer.Position = 0;
        _preview = await ImportService.PrepareAsync(buffer);
        _busy = false;
    }

    private async Task ApplyAsync()
    {
        if (_preview?.Token is null)
        {
            return;
        }

        _busy = true;
        _result = await ImportService.ApplyAsync(_preview.Token);
        _preview = null;
        _importConfirmed = false;
        if (_result.Status == ImportApplyStatus.Applied)
        {
            await CollectionChanges.NotifyAsync();
        }

        _busy = false;
    }

    private async Task DiscardAsync()
    {
        if (_preview?.Token is { } token)
        {
            await ImportService.DiscardAsync(token);
        }

        _preview = null;
        _importConfirmed = false;
    }
}

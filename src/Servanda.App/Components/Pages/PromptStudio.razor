@page "/prompty/studio/{PromptId}"
@using Servanda.Domain.Prompts
@implements IAsyncDisposable
@inject IPromptLibraryService Library
@inject IJSRuntime JavaScript

<PageTitle>Prompt Studio — Servanda</PageTitle>

@if (_model is null)
{
    <div class="system-message">
        <h1>Nie znaleziono promptu</h1>
        <p>Wskazany prompt nie istnieje w tej kolekcji.</p>
        <p><a href="/prompty">Wróć do biblioteki promptów</a></p>
    </div>
}
else
{
    <div class="module-page">
        <header class="module-page__header">
            <p class="module-page__eyebrow">Prompt Studio</p>
            <h1>@_model.Title</h1>
            <p>@_model.Description</p>
            <p><a href="/prompty">Wróć do biblioteki promptów</a></p>
        </header>

        <div class="module-page__body">
            <section class="module-page__aside" aria-labelledby="studio-fields-heading">
                <h2 id="studio-fields-heading">Wartości</h2>

                <div class="field">
                    <label for="studio-variant">Wariant</label>
                    <select id="studio-variant" @onchange="SelectVariant">
                        @foreach (var variant in _model.Variants)
                        {
                            <option value="@variant.Id" selected="@(variant.Id == _variantId)">
                                @variant.Name@(string.IsNullOrEmpty(variant.Target) ? string.Empty : $" — {variant.Target}")
                            </option>
                        }
                    </select>
                </div>

                @foreach (var variable in _usedVariables)
                {
                    <div class="field" @key="variable.Id">
                        <label for="@($"studio-{variable.Id}")">
                            @(string.IsNullOrEmpty(variable.Label) ? variable.Name : variable.Label)
                            @if (variable.IsRequired)
                            {
                                <span aria-hidden="true">*</span>
                            }
                        </label>
                        @if (variable.IsMultiline)
                        {
                            <textarea id="@($"studio-{variable.Id}")"
                                      rows="4"
                                      @oninput="args => SetValue(variable.Name, args.Value?.ToString())">@Value(variable.Name)</textarea>
                        }
                        else
                        {
                            <input id="@($"studio-{variable.Id}")"
                                   type="text"
                                   value="@Value(variable.Name)"
                                   @oninput="args => SetValue(variable.Name, args.Value?.ToString())" />
                        }
                    </div>
                }

                @if (_usedVariables.Count == 0)
                {
                    <p class="field__hint">Ten wariant nie używa żadnych zmiennych.</p>
                }
            </section>

            <section class="module-page__content" aria-labelledby="studio-preview-heading">
                <h2 id="studio-preview-heading">Podgląd</h2>

                <label class="field" for="studio-preview">
                    <span>Gotowa treść</span>
                    <textarea id="studio-preview" rows="16" readonly>@_preview</textarea>
                </label>

                <p class="module-page__status" role="status" aria-live="polite">@_status</p>

                @if (_missing.Count > 0)
                {
                    <p class="field__error">
                        Uzupełnij wymagane pola: @string.Join(", ", _missing).
                    </p>
                }

                <div class="module-editor__actions">
                    <button class="button button--primary"
                            type="button"
                            disabled="@(_missing.Count > 0 || _copying)"
                            @onclick="CopyAsync">
                        Kopiuj gotowy prompt
                    </button>
                </div>

                @if (_manualCopy)
                {
                    <p class="module-editor__conflict" role="alert">
                        Schowek przeglądarki jest niedostępny. Zaznacz treść w polu podglądu i skopiuj ją ręcznie
                        skrótem Ctrl+C.
                    </p>
                }
            </section>
        </div>
    </div>
}

@code {
    private readonly Dictionary<string, string> _values = new(StringComparer.Ordinal);
    private PromptEditorModel? _model;
    private IJSObjectReference? _clipboard;
    private IReadOnlyList<PromptVariableModel> _usedVariables = [];
    private IReadOnlyList<string> _missing = [];
    private string? _variantId;
    private string _preview = string.Empty;
    private string _status = string.Empty;
    private bool _manualCopy;
    private bool _copying;

    [Parameter]
    public string PromptId { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _model = await Library.GetForEditAsync(PromptId);
        if (_model is null)
        {
            return;
        }

        _variantId ??= _model.Variants.FirstOrDefault()?.Id;
        foreach (var variable in _model.Variables)
        {
            _values.TryAdd(variable.Name, variable.DefaultValue);
        }

        Refresh();
    }

    private void SelectVariant(ChangeEventArgs args)
    {
        _variantId = args.Value?.ToString();
        _manualCopy = false;
        Refresh();
    }

    private string Value(string name) => _values.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetValue(string name, string? value)
    {
        _values[name] = value ?? string.Empty;
        Refresh();
    }

    /// <summary>
    /// Podgląd, lista pól i stan przycisku wynikają wyłącznie z wybranego wariantu.
    /// </summary>
    private void Refresh()
    {
        var variant = _model?.Variants.FirstOrDefault(item => item.Id == _variantId);
        if (variant is null)
        {
            _preview = string.Empty;
            _usedVariables = [];
            _missing = [];
            return;
        }

        var used = PromptTemplate.ExtractPlaceholders(variant.Content);
        _usedVariables = [.. _model!.Variables.Where(variable => used.Contains(variable.Name, StringComparer.Ordinal))];
        _missing =
        [
            .. _usedVariables
                .Where(variable => variable.IsRequired && Value(variable.Name).Length == 0)
                .Select(variable => string.IsNullOrEmpty(variable.Label) ? variable.Name : variable.Label)
        ];
        _preview = PromptTemplate.Render(variant.Content, _values);
        _status = _missing.Count > 0
            ? "Kopiowanie jest zablokowane do czasu uzupełnienia wymaganych pól."
            : $"Gotowa treść ma {_preview.Length} znaków.";
    }

    private async Task CopyAsync()
    {
        if (_model is null || _variantId is null || _missing.Count > 0)
        {
            return;
        }

        _copying = true;
        _clipboard ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./clipboard.js");
        var copied = await _clipboard.InvokeAsync<bool>("copy", _preview);
        _manualCopy = !copied;
        if (copied)
        {
            await Library.RecordUsageAsync(new RecordPromptUsageCommand(_model.Id, _variantId));
            _status = "Skopiowano gotowy prompt i zapisano wpis historii użycia.";
        }
        else
        {
            _status = "Nie udało się użyć schowka przeglądarki.";
        }

        _copying = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboard is not null)
        {
            try
            {
                await _clipboard.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit został zamknięty przed zwolnieniem modułu.
            }
        }
    }
}

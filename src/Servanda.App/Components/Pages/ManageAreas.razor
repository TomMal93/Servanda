@page "/manage-areas"
@inject IAreaService AreaService
@inject AreaChangeNotifier AreaChanges
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<PageTitle>Zarządzaj obszarami — Servanda</PageTitle>

<div class="area-management">
    <header class="area-management__header">
        <p class="area-management__eyebrow">Ustawienia pulpitu</p>
        <h1>Zarządzaj obszarami</h1>
        <p>
            Dodawaj własne planowane obszary, edytuj je, ustawiaj kolejność i widoczność oraz bezpiecznie odkładaj nieużywane obszary do archiwum.
        </p>
        <button class="button button--primary"
                type="button"
                @onclick="BeginCreate"
                disabled="@(_creating || _editingAreaId is not null || _archivingAreaId is not null)">
            Dodaj obszar
        </button>
    </header>

    @if (_creating)
    {
        <section class="area-creator" aria-labelledby="new-area-heading">
            <div class="area-editor__summary">
                <span class="area-editor__icon @AreaPresentation.AccentClass(_createForm.AccentKey)" aria-hidden="true">
                    @AreaPresentation.Icon(_createForm.IconKey)
                </span>
                <div>
                    <h2 id="new-area-heading">Nowy obszar</h2>
                    <span class="area-editor__status">Planowane</span>
                </div>
            </div>

            <EditForm EditContext="_editContext" OnSubmit="CreateAsync" FormName="create-area">
                <div class="field">
                    <label for="new-area-name">Nazwa <span aria-hidden="true">*</span></label>
                    <InputText id="new-area-name"
                               @bind-Value="_createForm.Name"
                               maxlength="80"
                               required
                               aria-describedby="new-area-name-help" />
                    <p id="new-area-name-help" class="field__hint">Od 1 do 80 znaków.</p>
                    @if (_errors.TryGetValue(nameof(CreateAreaForm.Name), out var createNameErrors))
                    {
                        @foreach (var error in createNameErrors)
                        {
                            <p class="field__error">@error</p>
                        }
                    }
                </div>

                <div class="field">
                    <label for="new-area-description">Opis</label>
                    <InputTextArea id="new-area-description"
                                   @bind-Value="_createForm.Description"
                                   maxlength="300"
                                   rows="4"
                                   aria-describedby="new-area-description-help" />
                    <p id="new-area-description-help" class="field__hint">Maksymalnie 300 znaków.</p>
                    @if (_errors.TryGetValue(nameof(CreateAreaForm.Description), out var createDescriptionErrors))
                    {
                        @foreach (var error in createDescriptionErrors)
                        {
                            <p class="field__error">@error</p>
                        }
                    }
                </div>

                <div class="area-creator__choices">
                    <div class="field">
                        <label for="new-area-icon">Ikona</label>
                        <InputSelect id="new-area-icon" @bind-Value="_createForm.IconKey">
                            <option value="generic">Ogólny obszar</option>
                            <option value="notes">Notatki</option>
                            <option value="home">Dom</option>
                            <option value="family">Rodzina</option>
                            <option value="vitality">Witalność</option>
                            <option value="budget">Budżet</option>
                            <option value="tools">Narzędzia</option>
                            <option value="prompts">Prompty</option>
                        </InputSelect>
                        @if (_errors.TryGetValue(nameof(CreateAreaForm.IconKey), out var iconErrors))
                        {
                            @foreach (var error in iconErrors)
                            {
                                <p class="field__error">@error</p>
                            }
                        }
                    </div>

                    <div class="field">
                        <label for="new-area-accent">Akcent</label>
                        <InputSelect id="new-area-accent" @bind-Value="_createForm.AccentKey">
                            <option value="accent-0">Limonkowy</option>
                            <option value="accent-1">Błękitny</option>
                            <option value="accent-2">Fioletowy</option>
                            <option value="accent-3">Pomarańczowy</option>
                            <option value="accent-4">Zielony</option>
                            <option value="accent-5">Różowy</option>
                        </InputSelect>
                        @if (_errors.TryGetValue(nameof(CreateAreaForm.AccentKey), out var accentErrors))
                        {
                            @foreach (var error in accentErrors)
                            {
                                <p class="field__error">@error</p>
                            }
                        }
                    </div>
                </div>

                <div class="area-editor__actions">
                    <button class="button button--primary" type="submit" disabled="@_saving">
                        @(_saving ? "Zapisywanie…" : "Dodaj obszar")
                    </button>
                    <button type="button" @onclick="CancelCreate" disabled="@_saving">Anuluj</button>
                </div>
            </EditForm>
        </section>
    }

    <div class="area-management__list">
        @foreach (var area in ActiveAreas)
        {
            <article class="area-editor @(area.IsHidden ? "area-editor--hidden" : string.Empty)" @key="area.Id">
                <div class="area-editor__summary">
                    <span class="area-editor__icon @AreaPresentation.AccentClass(area)" aria-hidden="true">
                        @AreaPresentation.Icon(area.IconKey)
                    </span>
                    <div>
                        <h2>@area.Name</h2>
                        <span class="area-editor__status">@(area.IsHidden ? "Ukryty · Planowane" : "Widoczny · Planowane")</span>
                    </div>
                </div>

                @if (_editingAreaId == area.Id)
                {
                    <EditForm EditContext="_editContext" OnSubmit="SaveAsync" FormName="@($"edit-area-{area.Id}")">
                        <div class="field">
                            <label for="@($"area-name-{area.Id}")">Nazwa <span aria-hidden="true">*</span></label>
                            <InputText id="@($"area-name-{area.Id}")"
                                       @bind-Value="_form.Name"
                                       maxlength="80"
                                       required
                                       aria-describedby="@NameDescriptionId(area)" />
                            <p id="@NameDescriptionId(area)" class="field__hint">Od 1 do 80 znaków.</p>
                            @if (_errors.TryGetValue(nameof(EditAreaForm.Name), out var nameErrors))
                            {
                                @foreach (var error in nameErrors)
                                {
                                    <p class="field__error">@error</p>
                                }
                            }
                        </div>

                        <div class="field">
                            <label for="@($"area-description-{area.Id}")">Opis</label>
                            <InputTextArea id="@($"area-description-{area.Id}")"
                                           @bind-Value="_form.Description"
                                           maxlength="300"
                                           rows="4"
                                           aria-describedby="@DescriptionDescriptionId(area)" />
                            <p id="@DescriptionDescriptionId(area)" class="field__hint">Maksymalnie 300 znaków.</p>
                            @if (_errors.TryGetValue(nameof(EditAreaForm.Description), out var descriptionErrors))
                            {
                                @foreach (var error in descriptionErrors)
                                {
                                    <p class="field__error">@error</p>
                                }
                            }
                        </div>

                        <div class="area-editor__actions">
                            <button class="button button--primary" type="submit" disabled="@_saving">
                                @(_saving ? "Zapisywanie…" : "Zapisz zmiany")
                            </button>
                            <button type="button" @onclick="CancelEdit" disabled="@_saving">Anuluj</button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <p class="area-editor__description">@area.Description</p>
                    <div class="area-editor__toolbar">
                        <button type="button"
                                @onclick="() => BeginEdit(area)"
                                disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null)">
                            Edytuj obszar
                        </button>
                        <button type="button"
                                aria-label="@(area.IsHidden ? $"Pokaż obszar: {area.Name}" : $"Ukryj obszar: {area.Name}")"
                                @onclick="() => SetVisibilityAsync(area, !area.IsHidden)"
                                disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null)">
                            @(area.IsHidden ? "Pokaż" : "Ukryj")
                        </button>
                        <div class="area-editor__ordering" role="group" aria-label="Kolejność obszaru @area.Name">
                            <button type="button"
                                    aria-label="Przenieś wyżej: @area.Name"
                                    @onclick="() => MoveUpAsync(area)"
                                    disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null || IsFirst(area))">
                                Wyżej
                            </button>
                            <button type="button"
                                    aria-label="Przenieś niżej: @area.Name"
                                    @onclick="() => MoveDownAsync(area)"
                                    disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null || IsLast(area))">
                                Niżej
                            </button>
                        </div>
                        <button type="button"
                                aria-label="Archiwizuj obszar: @area.Name"
                                @onclick="() => BeginArchive(area)"
                                disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null)">
                            Archiwizuj
                        </button>
                    </div>
                    @if (_archivingAreaId == area.Id)
                    {
                        <div class="area-editor__confirmation"
                             role="alert"
                             aria-labelledby="@ArchiveConfirmationId(area)">
                            <p id="@ArchiveConfirmationId(area)">
                                <strong>Archiwizować „@area.Name”?</strong>
                                Obszar zniknie z pulpitu i panelu bocznego, ale jego dane zostaną zachowane. Możesz go później przywrócić.
                            </p>
                            <div class="area-editor__actions">
                                <button class="button button--primary"
                                        type="button"
                                        aria-label="Potwierdź archiwizację: @area.Name"
                                        @onclick="() => SetArchivedAsync(area, true)"
                                        disabled="@_saving">
                                    Potwierdź archiwizację
                                </button>
                                <button type="button" @onclick="CancelArchive" disabled="@_saving">Anuluj</button>
                            </div>
                        </div>
                    }
                }
            </article>
        }
    </div>

    @if (ArchivedAreas.Any())
    {
        <section class="area-management__archive" aria-labelledby="archived-areas-heading">
            <header>
                <p class="area-management__eyebrow">Zachowane dane</p>
                <h2 id="archived-areas-heading">Archiwum</h2>
                <p>Zarchiwizowane obszary nie są widoczne na pulpicie ani w panelu bocznym.</p>
            </header>
            <div class="area-management__list">
                @foreach (var area in ArchivedAreas)
                {
                    <article class="area-editor area-editor--archived" @key="area.Id">
                        <div class="area-editor__summary">
                            <span class="area-editor__icon @AreaPresentation.AccentClass(area)" aria-hidden="true">
                                @AreaPresentation.Icon(area.IconKey)
                            </span>
                            <div>
                                <h3>@area.Name</h3>
                                <span class="area-editor__status">Zarchiwizowany · Planowane</span>
                            </div>
                        </div>
                        <p class="area-editor__description">@area.Description</p>
                        <div class="area-editor__actions">
                            <button type="button"
                                    aria-label="Przywróć obszar: @area.Name"
                                    @onclick="() => SetArchivedAsync(area, false)"
                                    disabled="@(_creating || _saving || _editingAreaId is not null || _archivingAreaId is not null)">
                                Przywróć obszar
                            </button>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <p class="area-management__message @MessageClass" aria-live="polite">@_message</p>
</div>

@code {
    private IReadOnlyList<AreaListItem> _areas = [];
    private bool _creating;
    private string? _editingAreaId;
    private string? _archivingAreaId;
    private AreaListItem? _editingArea;
    private EditAreaForm _form = new();
    private CreateAreaForm _createForm = new();
    private EditContext? _editContext;
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private string _message = string.Empty;
    private bool _saving;
    private string _contentEpoch = string.Empty;
    private long _orderingRevision;
    private IJSObjectReference? _unsavedChangesModule;

    private string MessageClass => string.IsNullOrEmpty(_message) ? string.Empty : "area-management__message--visible";

    private IEnumerable<AreaListItem> ActiveAreas => _areas.Where(area => area.ArchivedAt is null);

    private IEnumerable<AreaListItem> ArchivedAreas => _areas.Where(area => area.ArchivedAt is not null);

    protected override async Task OnInitializedAsync()
    {
        _areas = await AreaService.ListForManagementAsync();
        if (_areas.Count > 0)
        {
            _contentEpoch = _areas[0].ContentEpoch;
            _orderingRevision = _areas[0].OrderingRevision;
        }
    }

    private void BeginCreate()
    {
        _creating = true;
        _createForm = new CreateAreaForm();
        SetEditContext(_createForm);
        _errors = new Dictionary<string, string[]>();
        _message = "Wypełnij formularz. Nowy obszar zostanie dodany na końcu pulpitu.";
    }

    private void BeginEdit(AreaListItem area)
    {
        _editingAreaId = area.Id;
        _editingArea = area;
        _form = new EditAreaForm { Name = area.Name, Description = area.Description };
        SetEditContext(_form);
        _errors = new Dictionary<string, string[]>();
        _message = "Masz niezapisane zmiany dopiero po zmodyfikowaniu formularza.";
    }

    private void CancelEdit()
    {
        ClearEditContext();
        _ = DisableUnsavedChangesAsync();
        _editingAreaId = null;
        _editingArea = null;
        _errors = new Dictionary<string, string[]>();
        _message = "Anulowano edycję. Dane zapisane wcześniej nie zostały zmienione.";
    }

    private void CancelCreate()
    {
        ClearEditContext();
        _ = DisableUnsavedChangesAsync();
        _creating = false;
        _errors = new Dictionary<string, string[]>();
        _message = "Anulowano tworzenie obszaru.";
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _message = "Zapisywanie nowego obszaru…";
        _errors = new Dictionary<string, string[]>();
        try
        {
            var result = await AreaService.CreateAsync(new CreateAreaCommand(
                _createForm.Name,
                _createForm.Description,
                _createForm.IconKey,
                _createForm.AccentKey,
                _orderingRevision,
                _contentEpoch));

            switch (result.Status)
            {
                case CreateAreaStatus.Success:
                    await DisableUnsavedChangesAsync();
                    var createdArea = result.Area!;
                    _orderingRevision = createdArea.OrderingRevision;
                    _areas = _areas
                        .Select(area => area with { OrderingRevision = _orderingRevision })
                        .Append(createdArea)
                        .OrderBy(area => area.SortOrder)
                        .ToList();
                    ClearEditContext();
                    _creating = false;
                    _message = "Dodano planowany obszar do lokalnej bazy.";
                    await AreaChanges.NotifyAsync();
                    break;
                case CreateAreaStatus.ValidationFailed:
                    _errors = result.Errors ?? new Dictionary<string, string[]>();
                    _message = "Popraw wskazane pola przed zapisem.";
                    break;
                case CreateAreaStatus.Conflict:
                    _message = "Lista obszarów zmieniła się w innej karcie. Odśwież stronę i spróbuj ponownie.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_editingArea is null)
        {
            return;
        }

        _saving = true;
        _message = "Zapisywanie zmian…";
        _errors = new Dictionary<string, string[]>();
        try
        {
            var result = await AreaService.UpdateAsync(new UpdateAreaCommand(
                _editingArea.Id,
                _form.Name,
                _form.Description,
                _editingArea.Revision,
                _editingArea.ContentEpoch));

            switch (result.Status)
            {
                case UpdateAreaStatus.Success:
                    await DisableUnsavedChangesAsync();
                    var savedArea = result.Area!;
                    _areas = _areas.Select(area => area.Id == savedArea.Id ? savedArea : area).ToList();
                    ClearEditContext();
                    _editingAreaId = null;
                    _editingArea = null;
                    _message = "Zapisano zmiany w lokalnej bazie.";
                    await AreaChanges.NotifyAsync();
                    break;
                case UpdateAreaStatus.ValidationFailed:
                    _errors = result.Errors ?? new Dictionary<string, string[]>();
                    _message = "Popraw wskazane pola przed zapisem.";
                    break;
                case UpdateAreaStatus.Conflict:
                    _message = "Obszar zmienił się w innej karcie. Odśwież stronę i spróbuj ponownie.";
                    break;
                case UpdateAreaStatus.NotFound:
                    _message = "Nie znaleziono obszaru. Odśwież stronę.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private Task MoveUpAsync(AreaListItem area)
    {
        var activeAreas = ActiveAreas.ToList();
        var index = IndexOf(activeAreas, area);
        return index <= 0
            ? Task.CompletedTask
            : MoveAsync(area, activeAreas[index - 1].Id);
    }

    private Task MoveDownAsync(AreaListItem area)
    {
        var activeAreas = ActiveAreas.ToList();
        var index = IndexOf(activeAreas, area);
        if (index < 0 || index >= activeAreas.Count - 1)
        {
            return Task.CompletedTask;
        }

        var beforeAreaId = index + 2 < activeAreas.Count ? activeAreas[index + 2].Id : null;
        return MoveAsync(area, beforeAreaId);
    }

    private async Task MoveAsync(AreaListItem area, string? beforeAreaId)
    {
        _saving = true;
        _message = $"Zmiana kolejności obszaru „{area.Name}”…";
        try
        {
            var result = await AreaService.MoveAsync(new MoveAreaCommand(
                area.Id,
                beforeAreaId,
                _orderingRevision,
                _contentEpoch));
            switch (result.Status)
            {
                case MoveAreaStatus.Success:
                    _areas = result.Areas!;
                    _orderingRevision = _areas[0].OrderingRevision;
                    _message = $"Zmieniono kolejność obszaru „{area.Name}”.";
                    await AreaChanges.NotifyAsync();
                    break;
                case MoveAreaStatus.Conflict:
                    _message = "Lista obszarów zmieniła się w innej karcie. Odśwież stronę i spróbuj ponownie.";
                    break;
                case MoveAreaStatus.NotFound:
                    _message = "Nie znaleziono obszaru albo miejsca docelowego. Odśwież stronę.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetVisibilityAsync(AreaListItem area, bool isHidden)
    {
        _saving = true;
        _message = isHidden
            ? $"Ukrywanie obszaru „{area.Name}”…"
            : $"Pokazywanie obszaru „{area.Name}”…";
        try
        {
            var result = await AreaService.SetVisibilityAsync(new SetAreaVisibilityCommand(
                area.Id,
                isHidden,
                area.Revision,
                area.ContentEpoch));
            switch (result.Status)
            {
                case SetAreaVisibilityStatus.Success:
                    var savedArea = result.Area!;
                    _areas = _areas.Select(item => item.Id == savedArea.Id ? savedArea : item).ToList();
                    _message = isHidden
                        ? $"Ukryto obszar „{area.Name}” na pulpicie i w panelu bocznym."
                        : $"Obszar „{area.Name}” jest ponownie widoczny.";
                    await AreaChanges.NotifyAsync();
                    break;
                case SetAreaVisibilityStatus.Conflict:
                    _message = "Obszar zmienił się w innej karcie. Odśwież stronę i spróbuj ponownie.";
                    break;
                case SetAreaVisibilityStatus.NotFound:
                    _message = "Nie znaleziono obszaru. Odśwież stronę.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void BeginArchive(AreaListItem area)
    {
        _archivingAreaId = area.Id;
        _message = $"Potwierdź archiwizację obszaru „{area.Name}”.";
    }

    private void CancelArchive()
    {
        _archivingAreaId = null;
        _message = "Anulowano archiwizację. Obszar nie został zmieniony.";
    }

    private async Task SetArchivedAsync(AreaListItem area, bool isArchived)
    {
        _saving = true;
        _message = isArchived
            ? $"Archiwizowanie obszaru „{area.Name}”…"
            : $"Przywracanie obszaru „{area.Name}”…";
        try
        {
            var result = await AreaService.SetArchivedAsync(new SetAreaArchivedCommand(
                area.Id,
                isArchived,
                area.Revision,
                area.ContentEpoch));
            switch (result.Status)
            {
                case SetAreaArchivedStatus.Success:
                    var savedArea = result.Area!;
                    _areas = _areas.Select(item => item.Id == savedArea.Id ? savedArea : item).ToList();
                    _archivingAreaId = null;
                    _message = isArchived
                        ? $"Zarchiwizowano obszar „{area.Name}”. Dane zostały zachowane."
                        : $"Przywrócono obszar „{area.Name}” w poprzednim miejscu.";
                    await AreaChanges.NotifyAsync();
                    break;
                case SetAreaArchivedStatus.Conflict:
                    _message = "Obszar zmienił się w innej karcie. Odśwież stronę i spróbuj ponownie.";
                    break;
                case SetAreaArchivedStatus.NotFound:
                    _message = "Nie znaleziono obszaru. Odśwież stronę.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private static int IndexOf(IReadOnlyList<AreaListItem> areas, AreaListItem area)
    {
        for (var index = 0; index < areas.Count; index++)
        {
            if (areas[index].Id == area.Id)
            {
                return index;
            }
        }

        return -1;
    }

    private bool IsFirst(AreaListItem area) => IndexOf(ActiveAreas.ToList(), area) == 0;

    private bool IsLast(AreaListItem area)
    {
        var activeAreas = ActiveAreas.ToList();
        return IndexOf(activeAreas, area) == activeAreas.Count - 1;
    }

    private static string NameDescriptionId(AreaListItem area) => $"area-name-help-{area.Id}";

    private static string DescriptionDescriptionId(AreaListItem area) => $"area-description-help-{area.Id}";

    private static string ArchiveConfirmationId(AreaListItem area) => $"archive-confirmation-{area.Id}";

    private async void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        await EnableUnsavedChangesAsync();
    }

    private async Task EnableUnsavedChangesAsync()
    {
        try
        {
            _unsavedChangesModule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                "/unsaved-changes.js");
            await _unsavedChangesModule.InvokeVoidAsync("enable");
            _message = "Masz niezapisane zmiany.";
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
        }
    }

    private async Task DisableUnsavedChangesAsync()
    {
        if (_unsavedChangesModule is not null)
        {
            try
            {
                await _unsavedChangesModule.InvokeVoidAsync("disable");
            }
            catch (JSException)
            {
            }
        }
    }

    private void ClearEditContext()
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
            _editContext = null;
        }
    }

    private void SetEditContext(object model)
    {
        ClearEditContext();
        _editContext = new EditContext(model);
        _editContext.OnFieldChanged += HandleFieldChanged;
    }

    public async ValueTask DisposeAsync()
    {
        ClearEditContext();
        await DisableUnsavedChangesAsync();
        if (_unsavedChangesModule is not null)
        {
            try
            {
                await _unsavedChangesModule.DisposeAsync();
            }
            catch (JSException)
            {
            }
        }
    }

    private sealed class EditAreaForm
    {
        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;
    }

    private sealed class CreateAreaForm
    {
        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string IconKey { get; set; } = "generic";

        public string AccentKey { get; set; } = "accent-0";
    }
}

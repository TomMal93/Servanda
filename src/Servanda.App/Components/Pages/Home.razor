@page "/"
@inject IAreaService AreaService

<PageTitle>Pulpit — Servanda</PageTitle>

<div class="dashboard">
    <header class="dashboard__header">
        <p class="dashboard__eyebrow">Osobisty pulpit</p>
        <h1>Twoje obszary</h1>
        <p class="dashboard__intro">
            Servanda będzie porządkować ważne sprawy codzienności. Wszystkie obszary są obecnie planowane.
        </p>
    </header>

    <section aria-labelledby="areas-heading">
        <h2 id="areas-heading" class="dashboard__section-heading">Planowane obszary</h2>

        <div class="area-grid">
            @foreach (var area in _areas)
            {
                <article class="area-tile @AreaPresentation.AccentClass(area)"
                         data-area="@area.Id"
                         aria-labelledby="@AreaPresentation.HeadingId(area)">
                    <div class="area-tile__topline">
                        <span class="area-tile__icon" aria-hidden="true">
                            @AreaPresentation.Icon(area.IconKey)
                        </span>
                        <span class="area-tile__status">Planowane</span>
                    </div>
                    <h3 id="@AreaPresentation.HeadingId(area)">@area.Name</h3>
                    <p>@area.Description</p>
                </article>
            }
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<AreaListItem> _areas = [];

    protected override async Task OnInitializedAsync()
    {
        _areas = await AreaService.ListAsync();
    }
}

@page "/"
@inject IAreaService AreaService

<PageTitle>Pulpit — Servanda</PageTitle>

<div class="dashboard">
    <header class="dashboard__header">
        <p class="dashboard__eyebrow">Osobisty pulpit</p>
        <h1>Twoje obszary</h1>
        <p class="dashboard__intro">
            Servanda porządkuje ważne sprawy codzienności. Aktywne obszary prowadzą do swoich modułów, pozostałe są planowane.
        </p>
    </header>

    <section aria-labelledby="areas-heading">
        <h2 id="areas-heading" class="dashboard__section-heading">Obszary pulpitu</h2>

        <div class="area-grid">
            @foreach (var area in _areas)
            {
                <article class="area-tile @AreaPresentation.AccentClass(area)"
                         data-area="@area.Id"
                         aria-labelledby="@AreaPresentation.HeadingId(area)">
                    <div class="area-tile__topline">
                        <span class="area-tile__icon" aria-hidden="true">
                            @AreaPresentation.Icon(area.IconKey)
                        </span>
                        <span class="area-tile__status">@StatusLabel(area)</span>
                    </div>
                    <h3 id="@AreaPresentation.HeadingId(area)">
                        @if (IsActive(area))
                        {
                            <a href="@ModuleArea.RouteFor(area.ModuleKey)">@area.Name</a>
                        }
                        else
                        {
                            @area.Name
                        }
                    </h3>
                    <p>@area.Description</p>
                </article>
            }
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<AreaListItem> _areas = [];

    private static bool IsActive(AreaListItem area) =>
        area.Availability == "active"
        && ModuleArea.RouteFor(area.ModuleKey) != "/";

    private static string StatusLabel(AreaListItem area) => IsActive(area) ? "Aktywny" : "Planowane";

    protected override async Task OnInitializedAsync()
    {
        _areas = await AreaService.ListAsync();
    }
}

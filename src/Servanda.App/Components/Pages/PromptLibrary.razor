@page "/prompty"
@inject IAreaService AreaService
@inject ICategoryService CategoryService
@inject IPromptLibraryService Library
@inject NavigationManager Navigation

<PageTitle>Skarbiec promptów — Servanda</PageTitle>

@if (_area is null)
{
    <div class="system-message">
        <h1>Moduł promptów jest niedostępny</h1>
        <p>Obszar biblioteki promptów nie jest aktywny w tej kolekcji.</p>
    </div>
}
else
{
    <div class="module-page">
        <header class="module-page__header">
            <p class="module-page__eyebrow">Obszar</p>
            <h1>@_area.Name</h1>
            <p>@_area.Description</p>
        </header>

        <div class="module-page__body">
            <aside class="module-page__aside">
                <CategoryTreeView Nodes="_tree?.Roots ?? []"
                                  SelectedCategoryId="@CategoryId"
                                  TotalCount="_allCount"
                                  SelectedCategoryIdChanged="SelectCategoryAsync" />
                <CategoryManager AreaId="@_area.Id"
                                 Tree="_tree"
                                 SelectedCategoryId="@CategoryId"
                                 Changed="ReloadAllAsync" />
            </aside>

            <section class="module-page__content" aria-labelledby="prompts-heading">
                <div class="module-page__toolbar">
                    <h2 id="prompts-heading">Prompty</h2>
                    <button class="button button--primary"
                            type="button"
                            @onclick="BeginCreate"
                            disabled="@(_tree is null || _tree.Roots.Count == 0)">
                        Dodaj prompt
                    </button>
                </div>

                <div class="prompt-filters" role="group" aria-label="Filtry biblioteki">
                    @foreach (var option in FilterOptions)
                    {
                        <button type="button"
                                class="@(CurrentFilter == option.Value ? "prompt-filters__item prompt-filters__item--active" : "prompt-filters__item")"
                                aria-pressed="@(CurrentFilter == option.Value)"
                                @onclick="() => SelectFilterAsync(option.Value)">
                            @option.Label
                        </button>
                    }
                </div>

                <SearchField Id="prompt-search"
                             Label="Szukaj promptu"
                             Placeholder="Tytuł, opis, tag lub treść wariantu"
                             Value="@(Text ?? string.Empty)"
                             ValueChanged="SearchAsync" />

                <p class="module-page__status" role="status" aria-live="polite">
                    @if (_loading)
                    {
                        @:Wyszukiwanie…
                    }
                    else if (_queryTooShort)
                    {
                        @:Wpisz co najmniej dwa znaki, aby wyszukać.
                    }
                    else
                    {
                        @($"Widoczne prompty: {_items.Count} z {_total}.")
                    }
                </p>

                @if (_editor is not null)
                {
                    <PromptEditor Model="_editor"
                                  Tree="_tree!"
                                  Saved="OnEditorSavedAsync"
                                  Cancelled="() => { _editor = null; return Task.CompletedTask; }" />
                }

                @if (_items.Count == 0 && !_loading)
                {
                    <div class="module-page__empty">
                        <p>Brak promptów spełniających kryteria.</p>
                        <button type="button" @onclick="ClearFiltersAsync">Wyczyść wyszukiwanie i filtr</button>
                    </div>
                }
                else
                {
                    <div class="prompt-grid">
                        @foreach (var prompt in _items)
                        {
                            <article class="prompt-card" @key="prompt.Id">
                                <div class="prompt-card__topline">
                                    <h3>@prompt.Title</h3>
                                    <button type="button"
                                            aria-pressed="@prompt.IsFavorite"
                                            @onclick="() => ToggleFavoriteAsync(prompt)">
                                        @(prompt.IsFavorite ? "Ulubiony" : "Dodaj do ulubionych")
                                    </button>
                                </div>
                                <p class="prompt-card__description">@prompt.Description</p>
                                @if (prompt.VisibleTags.Count > 0)
                                {
                                    <ul class="prompt-card__tags">
                                        @foreach (var tag in prompt.VisibleTags)
                                        {
                                            <li @key="tag">@tag</li>
                                        }
                                        @if (prompt.HiddenTagCount > 0)
                                        {
                                            <li>+@prompt.HiddenTagCount</li>
                                        }
                                    </ul>
                                }
                                <p class="prompt-card__meta">
                                    Warianty: @prompt.VariantCount ·
                                    @(prompt.LastUsedAt is null
                                        ? "jeszcze nieużywany"
                                        : $"ostatnio użyty {prompt.LastUsedAt.Value.ToLocalTime():g}")
                                </p>
                                @if (prompt.MatchExplanation is not null)
                                {
                                    <p class="prompt-card__match">@prompt.MatchExplanation</p>
                                }
                                <div class="prompt-card__actions">
                                    <a href="@($"/prompty/studio/{prompt.Id}")">Otwórz Prompt Studio</a>
                                    <button type="button" @onclick="() => BeginEditAsync(prompt.Id)">Edytuj</button>
                                </div>
                            </article>
                        }
                    </div>

                    @if (_hasMore)
                    {
                        <button class="module-page__more" type="button" @onclick="LoadMoreAsync">Pokaż więcej</button>
                    }
                }

                @if (_conflict)
                {
                    <p class="module-editor__conflict" role="alert">
                        Prompt został zmieniony w innej karcie. Odśwież widok i spróbuj ponownie.
                    </p>
                }
            </section>
        </div>
    </div>
}

@code {
    private static readonly (string Value, string Label)[] FilterOptions =
    [
        ("wszystkie", "Wszystkie"),
        ("ulubione", "Ulubione"),
        ("ostatnie", "Ostatnio używane"),
    ];

    private AreaListItem? _area;
    private CategoryTree? _tree;
    private readonly List<PromptCard> _items = [];
    private PromptEditorState? _editor;
    private string _contentEpoch = string.Empty;
    private int _total;
    private int _allCount;
    private bool _hasMore;
    private bool _loading;
    private bool _queryTooShort;
    private bool _conflict;
    private string? _loadedKey;

    [SupplyParameterFromQuery(Name = "kategoria")]
    public string? CategoryId { get; set; }

    [SupplyParameterFromQuery(Name = "filtr")]
    public string? Filter { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Text { get; set; }

    private string CurrentFilter => Filter is "ulubione" or "ostatnie" ? Filter : "wszystkie";

    protected override async Task OnParametersSetAsync()
    {
        _area ??= await ModuleArea.FindAsync(AreaService, ModuleArea.PromptsModuleKey);
        if (_area is null)
        {
            return;
        }

        _tree ??= await CategoryService.GetTreeAsync(_area.Id);
        var key = $"{CategoryId}|{CurrentFilter}|{Text}";
        if (_items.Count > 0 && string.Equals(_loadedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        _loadedKey = key;
        await LoadPageAsync(reset: true);
    }

    private async Task LoadPageAsync(bool reset)
    {
        if (_area is null)
        {
            return;
        }

        _loading = true;
        if (reset)
        {
            _items.Clear();
        }

        var page = await Library.SearchAsync(new PromptQuery(
            _area.Id,
            CurrentFilter switch
            {
                "ulubione" => PromptFilter.Favorites,
                "ostatnie" => PromptFilter.RecentlyUsed,
                _ => PromptFilter.All,
            },
            CategoryId,
            Text,
            _items.Count));
        _items.AddRange(page.Items);
        _total = page.TotalCount;
        _hasMore = page.HasMore;
        _queryTooShort = page.QueryTooShort;
        _contentEpoch = page.ContentEpoch;
        if (CategoryId is null && string.IsNullOrEmpty(Text) && CurrentFilter == "wszystkie")
        {
            _allCount = page.TotalCount;
        }

        _loading = false;
    }

    private Task LoadMoreAsync() => LoadPageAsync(reset: false);

    private Task SelectCategoryAsync(string? categoryId) => NavigateAsync(categoryId, CurrentFilter, Text);

    private Task SelectFilterAsync(string filter) => NavigateAsync(CategoryId, filter, Text);

    private Task SearchAsync(string text) => NavigateAsync(CategoryId, CurrentFilter, text);

    private Task ClearFiltersAsync() => NavigateAsync(null, "wszystkie", null);

    private Task NavigateAsync(string? categoryId, string filter, string? text)
    {
        var query = new Dictionary<string, object?>
        {
            ["kategoria"] = string.IsNullOrEmpty(categoryId) ? null : categoryId,
            ["filtr"] = filter == "wszystkie" ? null : filter,
            ["q"] = string.IsNullOrEmpty(text) ? null : text,
        };
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(query),
            forceLoad: false,
            replace: true);
        return Task.CompletedTask;
    }

    private async Task ReloadAllAsync()
    {
        if (_area is null)
        {
            return;
        }

        _tree = await CategoryService.GetTreeAsync(_area.Id);
        await LoadPageAsync(reset: true);
    }

    private void BeginCreate()
    {
        var categoryId = CategoryId ?? _tree?.Roots.FirstOrDefault()?.Category.Id;
        if (categoryId is not null)
        {
            _editor = PromptEditorState.ForCreate(_area!.Id, categoryId, _tree!.ContentEpoch);
        }
    }

    private async Task BeginEditAsync(string promptId)
    {
        var model = await Library.GetForEditAsync(promptId);
        if (model is not null)
        {
            _editor = PromptEditorState.ForEdit(model);
        }
    }

    private async Task OnEditorSavedAsync()
    {
        _editor = null;
        await ReloadAllAsync();
    }

    private async Task ToggleFavoriteAsync(PromptCard prompt)
    {
        _conflict = false;
        var result = await Library.SetFavoriteAsync(new SetPromptFavoriteCommand(
            prompt.Id,
            !prompt.IsFavorite,
            prompt.Revision,
            _contentEpoch));
        if (result.Status == WriteStatus.Success && result.Prompt is not null)
        {
            var index = _items.FindIndex(item => item.Id == prompt.Id);
            if (index >= 0)
            {
                _items[index] = result.Prompt;
            }
        }
        else
        {
            _conflict = true;
        }
    }
}

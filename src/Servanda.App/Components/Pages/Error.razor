@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd — Servanda</PageTitle>

<section class="system-message system-message--error" aria-labelledby="error-heading">
    <h1 id="error-heading">Nie udało się wyświetlić strony</h1>
    <p>Wystąpił nieoczekiwany błąd. Odśwież stronę i spróbuj ponownie.</p>

    @if (ShowRequestId)
    {
        <p class="system-message__detail">
            Identyfikator zdarzenia: <code>@RequestId</code>
        </p>
    }
</section>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() => RequestId = Activity.Current?.Id;
}

@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="search-field">
    <label for="@Id">@Label</label>
    <input id="@Id"
           class="search-field__input"
           type="search"
           value="@_text"
           autocomplete="off"
           placeholder="@Placeholder"
           aria-describedby="@($"{Id}-hint")"
           @oninput="OnInputAsync"
           @onkeydown="OnKeyDownAsync" />
    <p id="@($"{Id}-hint")" class="search-field__hint">
        Wpisz co najmniej dwa znaki. Skrót Ctrl+K ustawia fokus w polu, Escape czyści zapytanie.
    </p>
</div>

@code {
    private const int DebounceMilliseconds = 250;

    private IJSObjectReference? _module;
    private CancellationTokenSource? _debounce;
    private string _text = string.Empty;

    [Parameter, EditorRequired]
    public required string Id { get; set; }

    [Parameter]
    public string Label { get; set; } = "Szukaj";

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (_debounce is null)
        {
            _text = Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/search-shortcut.js");
            await _module.InvokeVoidAsync("register", Id);
        }
        catch (JSException)
        {
            // Skrót Ctrl+K jest dodatkiem; widoczne pole pozostaje dostępne klawiaturą.
        }
    }

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? string.Empty;
        await PublishAsync(_text, debounce: true);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || _text.Length == 0)
        {
            return;
        }

        _text = string.Empty;
        await PublishAsync(_text, debounce: false);
    }

    /// <summary>
    /// Nowe zapytanie anuluje poprzednie oczekujące wyszukiwanie.
    /// </summary>
    private async Task PublishAsync(string text, bool debounce)
    {
        if (_debounce is not null)
        {
            await _debounce.CancelAsync();
            _debounce.Dispose();
        }

        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        if (!debounce)
        {
            await ValueChanged.InvokeAsync(text);
            return;
        }

        try
        {
            await Task.Delay(DebounceMilliseconds, token);
            await ValueChanged.InvokeAsync(text);
        }
        catch (OperationCanceledException)
        {
            // Wynik anulowanego zapytania nie może zastąpić nowszej odpowiedzi.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_debounce is not null)
        {
            await _debounce.CancelAsync();
            _debounce.Dispose();
            _debounce = null;
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit został zamknięty przed zwolnieniem modułu.
            }
        }
    }
}

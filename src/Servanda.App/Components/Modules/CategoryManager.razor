@inject ICategoryService CategoryService

<section class="category-manager" aria-labelledby="category-manager-heading">
    <h2 id="category-manager-heading">Kategorie</h2>

    <form class="category-manager__form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="field">
            <label for="category-name">Nowa kategoria</label>
            <input id="category-name"
                   type="text"
                   maxlength="60"
                   value="@_name"
                   @oninput="args => _name = args.Value?.ToString() ?? string.Empty"
                   aria-describedby="category-name-help" />
            <p id="category-name-help" class="field__hint">
                @(SelectedCategoryId is null
                    ? "Kategoria powstanie na najwyższym poziomie."
                    : "Kategoria powstanie w wybranej kategorii.")
            </p>
        </div>
        <div class="field">
            <label for="category-description">Opis nowej kategorii</label>
            <textarea id="category-description"
                      maxlength="240"
                      rows="2"
                      @bind="_description"></textarea>
        </div>
        <button class="button" type="submit" disabled="@(_busy || _name.Trim().Length == 0)">Dodaj</button>
    </form>

    @if (SelectedCategoryId is not null && Selected() is { } selected)
    {
        <form class="category-manager__form" @onsubmit="RenameAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="category-rename">Nazwa wybranej kategorii</label>
                <input id="category-rename"
                       type="text"
                       maxlength="60"
                       value="@_renameValue"
                       @oninput="args => _renameValue = args.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="field">
                <label for="category-rename-description">Opis wybranej kategorii</label>
                <textarea id="category-rename-description"
                          maxlength="240"
                          rows="2"
                          @bind="_renameDescription"></textarea>
            </div>
            <button class="button" type="submit" disabled="@_busy">Zmień nazwę</button>
            <button type="button" class="category-manager__danger" @onclick="PrepareDeleteAsync" disabled="@_busy">
                Usuń kategorię
            </button>
        </form>
        <p class="category-manager__selected">Wybrana kategoria: @selected.Category.Name</p>

        <div class="category-manager__form" aria-label="Położenie wybranej kategorii">
            <div class="field">
                <label for="category-parent">Kategoria nadrzędna</label>
                <select id="category-parent" @bind="_targetParentId">
                    <option value="">Najwyższy poziom</option>
                    @foreach (var option in AvailableParents(selected))
                    {
                        <option value="@option.Id">@option.Label</option>
                    }
                </select>
            </div>
            <button type="button"
                    @onclick="MoveToParentAsync"
                    disabled="@(_busy || string.Equals(_targetParentId, selected.Category.ParentId ?? string.Empty, StringComparison.Ordinal))">
                Przenieś do wybranej kategorii
            </button>
            <div class="module-editor__order-actions">
                <button type="button"
                        aria-label="Przenieś kategorię wyżej: @selected.Category.Name"
                        @onclick="() => MoveByOffsetAsync(-1)"
                        disabled="@(_busy || IsFirst(selected))">Wyżej</button>
                <button type="button"
                        aria-label="Przenieś kategorię niżej: @selected.Category.Name"
                        @onclick="() => MoveByOffsetAsync(1)"
                        disabled="@(_busy || IsLast(selected))">Niżej</button>
            </div>
        </div>

        @if (_deletePreview is not null)
        {
            <div class="module-editor__confirmation" role="group" aria-labelledby="category-delete-heading">
                <h3 id="category-delete-heading">Usuń kategorię „@_deletePreview.Name”?</h3>
                <p>Operacja usunie:</p>
                <ul>
                    <li>kategorie podrzędne: @_deletePreview.DescendantCategories,</li>
                    <li>narzędzia: @_deletePreview.Tools,</li>
                    <li>prompty: @_deletePreview.Prompts.</li>
                </ul>
                @if (_deletePreview.RequiresProtectionBackup)
                {
                    <p>Bezpośrednio przed usunięciem zostanie utworzona i zweryfikowana kopia ochronna.</p>
                }
                <label class="module-editor__confirm">
                    <input type="checkbox" @bind="_deleteConfirmed" />
                    Rozumiem zakres operacji i potwierdzam usunięcie
                </label>
                <div class="module-editor__actions">
                    <button type="button"
                            class="category-manager__danger"
                            @onclick="DeleteAsync"
                            disabled="@(_busy || !_deleteConfirmed)">Usuń wskazane dane</button>
                    <button type="button" @onclick="CancelDelete" disabled="@_busy">Anuluj</button>
                </div>
            </div>
        }
    }

    @foreach (var message in _messages)
    {
        <p class="category-manager__message" role="alert">@message</p>
    }
    @if (_successMessage is not null)
    {
        <p class="module-editor__status" role="status" aria-live="polite">@_successMessage</p>
    }
</section>

@code {
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _renameValue = string.Empty;
    private string _renameDescription = string.Empty;
    private string? _renameSource;
    private string _targetParentId = string.Empty;
    private CategoryDeletePreview? _deletePreview;
    private bool _deleteConfirmed;
    private bool _busy;
    private IReadOnlyList<string> _messages = [];
    private string? _successMessage;

    [Parameter, EditorRequired]
    public required string AreaId { get; set; }

    [Parameter]
    public CategoryTree? Tree { get; set; }

    [Parameter]
    public string? SelectedCategoryId { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_renameSource, SelectedCategoryId, StringComparison.Ordinal))
        {
            _renameSource = SelectedCategoryId;
            var selected = Selected();
            _renameValue = selected?.Category.Name ?? string.Empty;
            _renameDescription = selected?.Category.Description ?? string.Empty;
            _targetParentId = selected?.Category.ParentId ?? string.Empty;
            _deletePreview = null;
            _deleteConfirmed = false;
        }
    }

    private CategoryNode? Selected() =>
        SelectedCategoryId is null || Tree is null ? null : Find(Tree.Roots, SelectedCategoryId);

    private static CategoryNode? Find(IReadOnlyList<CategoryNode> nodes, string id)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.Category.Id, id, StringComparison.Ordinal))
            {
                return node;
            }

            var found = Find(node.Children, id);
            if (found is not null)
            {
                return found;
            }
        }

        return null;
    }

    private async Task CreateAsync()
    {
        if (Tree is null)
        {
            return;
        }

        _busy = true;
        var result = await CategoryService.CreateAsync(new CreateCategoryCommand(
            AreaId,
            SelectedCategoryId,
            _name,
            _description,
            Tree.ScopeRevisionFor(SelectedCategoryId),
            Tree.ContentEpoch));
        _busy = false;
        if (result.Status == WriteStatus.Success)
        {
            _name = string.Empty;
            _description = string.Empty;
        }

        await ReportAsync(result);
    }

    private async Task RenameAsync()
    {
        var selected = Selected();
        if (Tree is null || selected is null)
        {
            return;
        }

        _busy = true;
        var result = await CategoryService.UpdateAsync(new UpdateCategoryCommand(
            selected.Category.Id,
            _renameValue,
            _renameDescription,
            selected.Category.Revision,
            Tree.ContentEpoch));
        _busy = false;
        await ReportAsync(result);
    }

    private async Task PrepareDeleteAsync()
    {
        var selected = Selected();
        if (selected is null)
        {
            return;
        }

        _busy = true;
        _deletePreview = await CategoryService.PreviewDeleteAsync(selected.Category.Id);
        _deleteConfirmed = false;
        _busy = false;
        if (_deletePreview is null)
        {
            _messages = ["Kategoria już nie istnieje. Odśwież widok."];
        }
    }

    private void CancelDelete()
    {
        _deletePreview = null;
        _deleteConfirmed = false;
    }

    private async Task DeleteAsync()
    {
        if (_deletePreview is null || !_deleteConfirmed)
        {
            return;
        }

        _busy = true;
        var preview = _deletePreview;
        var result = await CategoryService.DeleteAsync(new DeleteCategoryCommand(
            preview.Id,
            preview.Revision,
            preview.ParentScopeRevision,
            preview.ContentEpoch,
            preview.DescendantCategories,
            preview.Tools,
            preview.Prompts,
            Confirmed: true));
        _busy = false;
        _deletePreview = null;
        _deleteConfirmed = false;
        await ReportAsync(result);
    }

    private IEnumerable<(string Id, string Label)> AvailableParents(CategoryNode selected)
    {
        var excluded = DescendantIds(selected).ToHashSet(StringComparer.Ordinal);
        excluded.Add(selected.Category.Id);
        return CategoryOptions.Flatten(Tree?.Roots ?? [])
            .Where(option => !excluded.Contains(option.Id));
    }

    private static IEnumerable<string> DescendantIds(CategoryNode node)
    {
        foreach (var child in node.Children)
        {
            yield return child.Category.Id;
            foreach (var descendant in DescendantIds(child))
            {
                yield return descendant;
            }
        }
    }

    private IReadOnlyList<CategoryNode> Siblings(CategoryNode selected) =>
        selected.Category.ParentId is null
            ? Tree?.Roots ?? []
            : Find(Tree?.Roots ?? [], selected.Category.ParentId)?.Children ?? [];

    private bool IsFirst(CategoryNode selected) => IndexOf(Siblings(selected), selected) <= 0;

    private bool IsLast(CategoryNode selected)
    {
        var siblings = Siblings(selected);
        return IndexOf(siblings, selected) == siblings.Count - 1;
    }

    private Task MoveToParentAsync()
    {
        var selected = Selected();
        if (selected is null)
        {
            return Task.CompletedTask;
        }

        return MoveAsync(selected, string.IsNullOrEmpty(_targetParentId) ? null : _targetParentId, null);
    }

    private Task MoveByOffsetAsync(int offset)
    {
        var selected = Selected();
        if (selected is null)
        {
            return Task.CompletedTask;
        }

        var siblings = Siblings(selected);
        var ids = siblings.Select(item => item.Category.Id).ToList();
        if (OrderingPlacement.TryMoveByOffset(ids, selected.Category.Id, offset, out var beforeId))
        {
            return MoveAsync(selected, selected.Category.ParentId, beforeId);
        }

        return Task.CompletedTask;
    }

    private static int IndexOf(IReadOnlyList<CategoryNode> nodes, CategoryNode selected)
    {
        for (var index = 0; index < nodes.Count; index++)
        {
            if (string.Equals(nodes[index].Category.Id, selected.Category.Id, StringComparison.Ordinal))
            {
                return index;
            }
        }

        return -1;
    }

    private async Task MoveAsync(CategoryNode selected, string? targetParentId, string? beforeCategoryId)
    {
        if (Tree is null)
        {
            return;
        }

        _busy = true;
        var result = await CategoryService.MoveAsync(new MoveCategoryCommand(
            selected.Category.Id,
            targetParentId,
            beforeCategoryId,
            selected.Category.Revision,
            Tree.ScopeRevisionFor(selected.Category.ParentId),
            Tree.ScopeRevisionFor(targetParentId),
            Tree.ContentEpoch));
        _busy = false;
        await ReportAsync(result);
    }

    private async Task ReportAsync(CategoryResult result)
    {
        _successMessage = result.Status == WriteStatus.Success ? "Zapisano zmianę kategorii." : null;
        _messages = result.Status switch
        {
            WriteStatus.Success => [],
            WriteStatus.ValidationFailed => [.. (result.Errors ?? new Dictionary<string, string[]>()).SelectMany(entry => entry.Value)],
            WriteStatus.Conflict => ["Kategorie zmieniły się w innej karcie. Odśwież widok i spróbuj ponownie."],
            _ => ["Nie znaleziono wskazanej kategorii."],
        };
        if (result.Status == WriteStatus.Success)
        {
            _renameSource = null;
            await Changed.InvokeAsync();
        }
    }
}

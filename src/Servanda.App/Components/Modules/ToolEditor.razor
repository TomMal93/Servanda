@implements IAsyncDisposable
@inject IToolCatalogService Catalog
@inject IJSRuntime JavaScript

<section class="module-editor" aria-labelledby="tool-editor-heading">
    <h3 id="tool-editor-heading">@(Model.IsNew ? "Nowe narzędzie" : "Edycja narzędzia")</h3>

    <EditForm EditContext="_editContext"
              OnValidSubmit="SaveAsync"
              FormName="tool-editor"
              @oninput="_ => MarkDirty()"
              @onchange="_ => MarkDirty()">
        <div class="field">
            <label for="tool-name">Nazwa <span aria-hidden="true">*</span></label>
            <InputText id="tool-name" @bind-Value="Model.Name" maxlength="70" required />
            @foreach (var error in ErrorsFor("Name"))
            {
                <p class="field__error">@error</p>
            }
        </div>

        <div class="field">
            <label for="tool-description">Opis <span aria-hidden="true">*</span></label>
            <InputTextArea id="tool-description" @bind-Value="Model.Description" maxlength="280" rows="3" required />
            @foreach (var error in ErrorsFor("Description"))
            {
                <p class="field__error">@error</p>
            }
        </div>

        <div class="field">
            <label for="tool-url">Adres <span aria-hidden="true">*</span></label>
            <InputText id="tool-url" @bind-Value="Model.Url" maxlength="2048" required
                       aria-describedby="tool-url-help" />
            <p id="tool-url-help" class="field__hint">Dozwolone są wyłącznie adresy http:// i https://.</p>
            @foreach (var error in ErrorsFor("Url"))
            {
                <p class="field__error">@error</p>
            }
        </div>

        <div class="field">
            <label for="tool-tags">Tagi</label>
            <InputText id="tool-tags" @bind-Value="Model.Tags" aria-describedby="tool-tags-help" />
            <p id="tool-tags-help" class="field__hint">Rozdziel przecinkami, maksymalnie 8 tagów.</p>
            @foreach (var error in ErrorsFor("Tags"))
            {
                <p class="field__error">@error</p>
            }
        </div>

        <div class="field">
            <label for="tool-category">Kategoria</label>
            <InputSelect id="tool-category" @bind-Value="Model.CategoryId">
                @foreach (var option in CategoryOptions.Flatten(Tree.Roots))
                {
                    <option value="@option.Id">@option.Label</option>
                }
            </InputSelect>
        </div>

        <div class="field">
            <label for="tool-group">Grupa</label>
            <InputSelect id="tool-group" @bind-Value="Model.GroupKey">
                <option value="featured">Lubię i szanuję</option>
                <option value="regular">Fajne</option>
            </InputSelect>
        </div>

        @if (!Model.IsNew && MembershipChanged())
        {
            <p class="field__hint">
                Zmiana kategorii lub grupy jest osobną operacją i umieści narzędzie na końcu wybranej listy.
                @if (Model.ContentChanged())
                {
                    @: Najpierw zapisz treść, a następnie ponownie otwórz edytor, aby przenieść narzędzie.
                }
            </p>
        }

        @if (_conflict)
        {
            <p class="module-editor__conflict" role="alert">
                Dane zostały zmienione w innej karcie. Odśwież widok i wprowadź zmianę ponownie.
            </p>
        }

        <div class="module-editor__actions">
            <button class="button button--primary" type="submit" disabled="@_saving">
                @(_saving ? "Zapisywanie…" : "Zapisz")
            </button>
            <button type="button" @onclick="CancelAsync" disabled="@_saving">Anuluj</button>
            @if (!Model.IsNew && MembershipChanged())
            {
                <button type="button" @onclick="MoveAsync" disabled="@(_saving || Model.ContentChanged())">
                    Przenieś narzędzie
                </button>
            }
            @if (!Model.IsNew)
            {
                <button type="button" class="module-editor__danger" @onclick="() => _deleteRequested = true" disabled="@_saving">
                    Usuń narzędzie
                </button>
            }
        </div>

        <p class="module-editor__status" role="status" aria-live="polite">@_status</p>

        @if (_deleteRequested)
        {
            <div class="module-editor__confirmation" role="group" aria-labelledby="tool-delete-heading">
                <h4 id="tool-delete-heading">Usuń narzędzie „@Model.Name”?</h4>
                <p>Narzędzie i jego przypisania tagów zostaną trwale usunięte.</p>
                <label class="module-editor__confirm">
                    <input type="checkbox" @bind="_deleteConfirmed" @onchange:stopPropagation />
                    Potwierdzam usunięcie tego narzędzia
                </label>
                <div class="module-editor__actions">
                    <button type="button" class="module-editor__danger" @onclick="DeleteAsync"
                            disabled="@(_saving || !_deleteConfirmed)">Usuń trwale</button>
                    <button type="button" @onclick="CancelDelete" disabled="@_saving">Anuluj</button>
                </div>
            </div>
        }
    </EditForm>
</section>

@code {
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private EditContext? _editContext;
    private ToolEditorState? _editContextModel;
    private IJSObjectReference? _unsavedChanges;
    private bool _saving;
    private bool _conflict;
    private bool _dirty;
    private bool _guardEnabled;
    private string _status = "Edytor gotowy. Brak niezapisanych zmian.";
    private bool _deleteRequested;
    private bool _deleteConfirmed;

    [Parameter, EditorRequired]
    public required ToolEditorState Model { get; set; }

    [Parameter, EditorRequired]
    public required CategoryTree Tree { get; set; }

    [Parameter]
    public EventCallback Saved { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_editContextModel, Model))
        {
            return;
        }

        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= OnFieldChanged;
        }

        _editContextModel = Model;
        _editContext = new EditContext(Model);
        _editContext.OnFieldChanged += OnFieldChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _unsavedChanges = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/unsaved-changes.js");
        }

        if (_unsavedChanges is not null && _guardEnabled != _dirty)
        {
            await _unsavedChanges.InvokeVoidAsync(_dirty ? "enable" : "disable");
            _guardEnabled = _dirty;
        }
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs args) => MarkDirty();

    private void MarkDirty()
    {
        _dirty = true;
        _status = "Niezapisane zmiany.";
    }

    private IEnumerable<string> ErrorsFor(string field) =>
        _errors.TryGetValue(field, out var messages) ? messages : [];

    private bool MembershipChanged() =>
        !string.Equals(Model.CategoryId, Model.OriginalCategoryId, StringComparison.Ordinal)
        || !string.Equals(Model.GroupKey, Model.OriginalGroupKey, StringComparison.Ordinal);

    private async Task SaveAsync()
    {
        _saving = true;
        _status = "Zapisywanie…";
        _conflict = false;
        _errors = new Dictionary<string, string[]>();

        ToolResult result;
        if (Model.IsNew)
        {
            var scope = await Catalog.GetScopeAsync(Model.CategoryId, Model.GroupKey);
            result = await Catalog.CreateAsync(new CreateToolCommand(
                Model.AreaId,
                Model.CategoryId,
                Model.GroupKey,
                Model.Name,
                Model.Description,
                Model.Url,
                Model.TagNames(),
                scope.Revision,
                Tree.ContentEpoch));
        }
        else
        {
            result = await Catalog.UpdateAsync(new UpdateToolCommand(
                Model.Id!,
                Model.Name,
                Model.Description,
                Model.Url,
                Model.TagNames(),
                Model.Revision,
                Model.ContentEpoch));
        }

        _saving = false;
        await HandleAsync(result);
    }

    private async Task DeleteAsync()
    {
        _saving = true;
        _conflict = false;
        var scope = await Catalog.GetScopeAsync(Model.OriginalCategoryId, Model.OriginalGroupKey);
        var result = await Catalog.DeleteAsync(new DeleteToolCommand(
            Model.Id!,
            Model.Revision,
            scope.Revision,
            Model.ContentEpoch));
        _saving = false;
        await HandleAsync(result);
    }

    private void CancelDelete()
    {
        _deleteRequested = false;
        _deleteConfirmed = false;
    }

    private async Task MoveAsync()
    {
        if (Model.IsNew || !MembershipChanged())
        {
            return;
        }

        _saving = true;
        _status = "Zapisywanie zmiany położenia…";
        _conflict = false;
        var source = await Catalog.GetScopeAsync(Model.OriginalCategoryId, Model.OriginalGroupKey);
        var target = await Catalog.GetScopeAsync(Model.CategoryId, Model.GroupKey);
        var result = await Catalog.MoveAsync(new MoveToolCommand(
            Model.Id!,
            Model.CategoryId,
            Model.GroupKey,
            null,
            Model.Revision,
            source.Revision,
            target.Revision,
            Model.ContentEpoch));
        _saving = false;
        await HandleAsync(result);
    }

    private async Task HandleAsync(ToolResult result)
    {
        switch (result.Status)
        {
            case WriteStatus.Success:
                _dirty = false;
                _status = "Zapisano.";
                await DisableGuardAsync();
                await Saved.InvokeAsync();
                break;
            case WriteStatus.ValidationFailed:
                _errors = result.Errors ?? new Dictionary<string, string[]>();
                _status = "Błąd. Popraw wskazane pola.";
                break;
            default:
                _conflict = true;
                _status = "Konflikt. Dane zmieniły się w innej karcie.";
                break;
        }
    }

    private async Task CancelAsync()
    {
        _dirty = false;
        await DisableGuardAsync();
        await Cancelled.InvokeAsync();
    }

    private async Task DisableGuardAsync()
    {
        if (_unsavedChanges is not null && _guardEnabled)
        {
            await _unsavedChanges.InvokeVoidAsync("disable");
            _guardEnabled = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= OnFieldChanged;
        }

        if (_unsavedChanges is not null)
        {
            try
            {
                await DisableGuardAsync();
                await _unsavedChanges.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

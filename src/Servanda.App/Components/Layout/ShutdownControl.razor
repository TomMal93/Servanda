<section class="shutdown-control" aria-labelledby="@HeadingId">
    <h2 id="@HeadingId">Zamykanie aplikacji</h2>

    <button type="button"
            class="shutdown-control__toggle"
            aria-expanded="@_isConfirmationVisible"
            aria-controls="@ConfirmationId"
            @onclick="ToggleConfirmation">
        @(_isConfirmationVisible ? "Anuluj zamykanie" : "Zamknij Servandę")
    </button>

    <form id="@ConfirmationId"
          method="post"
          action="@ShutdownEndpoint.Path"
          aria-describedby="@(_isConfirmationVisible ? WarningId : null)"
          hidden="@(!_isConfirmationVisible)">
        <AntiforgeryToken />
        @if (_isConfirmationVisible)
        {
            <p id="@WarningId" role="alert">
                Zamknięcie Servandy rozłączy wszystkie otwarte karty aplikacji.
            </p>
            <button type="submit" class="shutdown-control__confirm">Tak, zamknij Servandę</button>
        }
    </form>
</section>

@code {
    [Parameter, EditorRequired]
    public required string Instance { get; set; }

    private bool _isConfirmationVisible;
    private string HeadingId => $"shutdown-heading-{Instance}";
    private string ConfirmationId => $"shutdown-confirmation-{Instance}";
    private string WarningId => $"shutdown-warning-{Instance}";

    private void ToggleConfirmation() => _isConfirmationVisible = !_isConfirmationVisible;
}

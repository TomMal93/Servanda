@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="navigation-drawer">
    <button @ref="_trigger"
            type="button"
            class="navigation-drawer__trigger"
            aria-haspopup="dialog"
            @onclick="OpenAsync">
        Otwórz panel boczny
    </button>

    <dialog @ref="_dialog"
            class="navigation-drawer__dialog"
            aria-label="Panel boczny">
        <div class="navigation-drawer__toolbar">
            <button type="button"
                    class="navigation-drawer__close"
                    autofocus
                    @onclick="CloseAsync">
                Zamknij panel boczny
            </button>
        </div>
        <SidebarContent Instance="drawer" />
    </dialog>
</div>

@code {
    private ElementReference _dialog;
    private ElementReference _trigger;
    private IJSObjectReference? _module;

    private async Task OpenAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("open", _dialog);
    }

    private async Task CloseAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("close", _dialog, _trigger);
    }

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/Layout/NavigationDrawer.razor.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Przejdź do treści</a>

<div class="app-shell">
    <NavigationDrawer />

    <aside class="sidebar" aria-label="Panel boczny">
        <SidebarContent Instance="desktop" />
    </aside>

    <main id="main-content" tabindex="-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    Wystąpił nieoczekiwany błąd aplikacji.
    <a href="." class="reload">Odśwież stronę</a>
    <button type="button" class="dismiss" aria-label="Zamknij komunikat błędu">×</button>
</div>

@inject IAreaService AreaService
@inject AreaChangeNotifier AreaChanges
@implements IDisposable

<div class="sidebar-content">
    <a class="sidebar-content__brand" href="/" aria-label="Servanda — pulpit">
        <span class="sidebar-content__brand-mark" aria-hidden="true">S</span>
        <span>Servanda</span>
    </a>

    <nav class="sidebar-content__navigation" aria-label="Główna nawigacja">
        <NavLink class="sidebar-content__home" href="/" Match="NavLinkMatch.All">
            Pulpit
        </NavLink>
        <NavLink class="sidebar-content__home" href="/manage-areas">
            Zarządzaj obszarami
        </NavLink>
    </nav>

    <section class="sidebar-content__areas" aria-labelledby="@AreasHeadingId" tabindex="0">
        <h2 id="@AreasHeadingId">Obszary</h2>
        <ul class="sidebar-content__area-list">
            @foreach (var area in _areas)
            {
                <li class="sidebar-content__area">
                    <span class="sidebar-content__area-name">@area.Name</span>
                    <span class="sidebar-content__status">Planowane</span>
                </li>
            }
        </ul>
    </section>

    <div class="sidebar-content__footer">
        <ShutdownControl Instance="@Instance" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Instance { get; set; }

    private string AreasHeadingId => $"sidebar-areas-heading-{Instance}";

    private IReadOnlyList<AreaListItem> _areas = [];

    protected override async Task OnInitializedAsync()
    {
        AreaChanges.Changed += ReloadAsync;
        _areas = await AreaService.ListAsync();
    }

    private async Task ReloadAsync()
    {
        _areas = await AreaService.ListAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AreaChanges.Changed -= ReloadAsync;
    }
}

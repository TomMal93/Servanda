{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:servanda:export:v1",
  "title": "Servanda export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "exportedAt",
    "applicationVersion",
    "areas",
    "categories",
    "tags",
    "tools",
    "prompts",
    "promptUsage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exportId": {
      "$ref": "#/$defs/ulid"
    },
    "exportedAt": {
      "$ref": "#/$defs/utcDateTime"
    },
    "applicationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt"
      }
    },
    "promptUsage": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/promptUsage"
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nullableUlid": {
      "oneOf": [
        {
          "$ref": "#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableUtcDateTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/utcDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "iconKey",
        "accentKey",
        "moduleKey",
        "availability",
        "sortOrder",
        "isHidden",
        "archivedAt",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "iconKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "accentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "moduleKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "availability": {
          "enum": [
            "active",
            "planned"
          ]
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "isHidden": {
          "type": "boolean"
        },
        "archivedAt": {
          "$ref": "#/$defs/nullableUtcDateTime"
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "areaId",
        "parentId",
        "name",
        "description",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "areaId": {
          "$ref": "#/$defs/ulid"
        },
        "parentId": {
          "$ref": "#/$defs/nullableUlid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "areaId",
        "name",
        "normalizedName",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "areaId": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "normalizedName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "areaId",
        "categoryId",
        "name",
        "description",
        "url",
        "groupKey",
        "sortOrder",
        "tagIds",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "areaId": {
          "$ref": "#/$defs/ulid"
        },
        "categoryId": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "groupKey": {
          "enum": [
            "featured",
            "regular"
          ]
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "tagIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ulid"
          }
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "promptVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "target",
        "content",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "maxLength": 30000
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "promptVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "defaultValue",
        "isRequired",
        "isMultiline",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 4000
        },
        "isRequired": {
          "type": "boolean"
        },
        "isMultiline": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "snapshotVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "target",
        "content",
        "sortOrder"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "maxLength": 30000
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshotVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "defaultValue",
        "isRequired",
        "isMultiline",
        "sortOrder"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 4000
        },
        "isRequired": {
          "type": "boolean"
        },
        "isMultiline": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "promptSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "variants",
        "variables"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/snapshotVariant"
          }
        },
        "variables": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/snapshotVariable"
          }
        }
      }
    },
    "promptVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "snapshot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "snapshot": {
          "$ref": "#/$defs/promptSnapshot"
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "areaId",
        "categoryId",
        "title",
        "description",
        "isFavorite",
        "sortOrder",
        "tagIds",
        "variants",
        "variables",
        "versions",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "areaId": {
          "$ref": "#/$defs/ulid"
        },
        "categoryId": {
          "$ref": "#/$defs/ulid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "isFavorite": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "tagIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ulid"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/promptVariant"
          }
        },
        "variables": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/promptVariable"
          }
        },
        "versions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/promptVersion"
          }
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "promptUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "promptId",
        "variantId",
        "titleSnapshot",
        "variantNameSnapshot",
        "usedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "promptId": {
          "$ref": "#/$defs/nullableUlid"
        },
        "variantId": {
          "$ref": "#/$defs/nullableUlid"
        },
        "titleSnapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "variantNameSnapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "usedAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    }
  }
}
